# ─────────────────────────────────────────────
#  MemoryOps – Environment Configuration
# ─────────────────────────────────────────────

# Groq LLM API key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Hindsight server base URL
# For managed cloud:   https://api.hindsight.vectorize.io
# For local self-host: http://localhost:8888
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# Hindsight Cloud API key (leave blank for local Hindsight)
HINDSIGHT_API_KEY=your_hindsight_api_key_here

# Hindsight memory bank ID
HINDSIGHT_BANK_ID=memoryops-incidents

# Groq model
GROQ_MODEL=qwen/qwen3.8-27b

# CORS allowed origin for the React frontend
FRONTEND_URL=http://localhost:5173
