# ─────────────────────────────────────────────────────────────
#  MemoryOps – Environment Configuration Template
#
#  Copy this file to .env and fill in your real values:
#    cp .env.example .env
#
#  NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────

# ── Groq LLM ─────────────────────────────────────────────────
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for incident analysis and recommendations.
# Tested default: qwen/qwen3.8-27b
# Note: llama-3.3-70b-versatile was removed from Groq and will return 404.
# Check https://console.groq.com/docs/models for the current model list.
GROQ_MODEL=qwen/qwen3.8-27b

# ── Hindsight Memory ──────────────────────────────────────────
# Hindsight Cloud endpoint (Vectorize-hosted):
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# Hindsight Cloud API key.
# Get yours at: https://vectorize.io
# IMPORTANT: The hindsight-client SDK does NOT auto-read this from the environment.
# It must be set here so the backend can pass it to Hindsight() explicitly.
HINDSIGHT_API_KEY=your_hindsight_api_key_here

# The Hindsight memory bank where incidents are stored and recalled.
# Create this bank in your Hindsight dashboard before running the app.
HINDSIGHT_BANK_ID=memoryops-incidents

# ── Frontend CORS ─────────────────────────────────────────────
# The URL the React frontend is served from.
# This is added to FastAPI's CORS allowed origins.
FRONTEND_URL=http://localhost:5173
