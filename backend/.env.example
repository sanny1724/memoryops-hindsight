# ─────────────────────────────────────────────
#  MemoryOps – Backend Environment
#  Copy this file to backend/.env
# ─────────────────────────────────────────────

# Groq LLM API key (get free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Hindsight server URL
# Self-hosted Docker: http://localhost:8888
# Hindsight Cloud:    https://api.hindsight.vectorize.io
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# Hindsight Cloud API key (leave blank for local Hindsight)
HINDSIGHT_API_KEY=your_hindsight_api_key_here

# Hindsight memory bank ID
HINDSIGHT_BANK_ID=memoryops-incidents

# Groq model to use
GROQ_MODEL=qwen/qwen3.8-27b

# CORS allowed origin for React frontend
FRONTEND_URL=http://localhost:5173
